---
import { GLYPHS, glyphViewBox, nextGlyphId, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const props = Astro.props;
const { name, size = 16 } = props;
const glyph = GLYPHS[name];
const id = nextGlyphId(name);
---

<svg
  viewBox={glyphViewBox(glyph.kind, size)}
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  class:list={['shrink-0', props.class]}
  set:html={glyph.body(id)}
/>
