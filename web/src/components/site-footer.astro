---
import { LINKS } from '@/lib/links';

const links = [
  { label: 'GitHub', href: LINKS.repo },
  { label: 'Releases', href: LINKS.releases },
  { label: 'Report an issue', href: LINKS.newIssue },
  { label: 'License', href: LINKS.license },
  { label: 'X', href: LINKS.x },
];
---

<footer class="flex flex-wrap items-center justify-between gap-3 px-9 py-[18px] text-[12.5px] text-text-muted max-[900px]:px-5">
  <span class="font-mono text-[11.5px]">MIT © Kamran Ahmed</span>
  <div class="flex gap-[18px]">
    {
      links.map((link) => (
        <a href={link.href} class="text-text-muted">
          {link.label}
        </a>
      ))
    }
  </div>
</footer>
